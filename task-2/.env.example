# Required. REST Countries v5 rejects unauthenticated requests.
# A working key is supplied with this submission; any key from
# https://restcountries.com works too.
# Read on the server only - it is never sent to the browser.
RESTCOUNTRIES_API_KEY=

# Optional: point the client at a different host, e.g. a mock server in tests.
# RESTCOUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5
