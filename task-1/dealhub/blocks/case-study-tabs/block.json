{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dealhub/case-study-tabs",
	"title": "Case Study Tabs",
	"description": "Tabbed customer case studies: client logo tabs, a quote, solution and CRM badges, headline stats and a testimonial video. Tabs become a swipeable slider on mobile.",
	"category": "dealhub",
	"icon": "slides",
	"keywords": [ "tabs", "case study", "testimonial", "logos", "slider" ],
	"textdomain": "dealhub",
	"supports": {
		"align": [ "full" ],
		"anchor": true,
		"html": false,
		"customClassName": true,
		"multiple": true,
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ]
		}
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"_is_preview": true
			}
		}
	},
	"acf": {
		"mode": "auto",
		"renderTemplate": "render.php"
	},
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"viewScript": "file:./view.js"
}
